{
  "name": "@psim/console",
  "version": "0.0.0",
  "private": true,
  "description": "PSIM web console: operator console and administration with role modules (Ф8; step 1.5 shell)",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "build": "tsc --project tsconfig.json && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173 --strictPort",
    "lint": "eslint --max-warnings 0 .",
    "typecheck": "tsc --project tsconfig.json",
    "test": "vitest run --coverage",
    "size": "size-limit",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@psim/api-client": "workspace:*",
    "@psim/design-system": "workspace:*",
    "@psim/realtime-client": "workspace:*",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-router": "1.170.41",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@size-limit/file": "14.1.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.2",
    "size-limit": "14.1.0",
    "tailwindcss": "4.3.3",
    "vite": "8.3.3"
  }
}
