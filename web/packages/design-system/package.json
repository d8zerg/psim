{
  "name": "@psim/design-system",
  "version": "0.0.0",
  "private": true,
  "description": "PSIM design system: Tailwind CSS 4 tokens and shadcn/ui-style components",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css",
    "./confirm-action": "./src/components/confirm-action.tsx",
    "./tokens": "./src/gen/tokens.ts",
    "./controls": "./src/components/controls.tsx",
    "./icons": "./src/components/icons.tsx",
    "./alarm-model": "./src/alarm-model.ts",
    "./pseudolocalize": "./src/pseudolocalize.ts",
    "./overlays": "./src/components/overlays.tsx",
    "./navigation": "./src/components/navigation.tsx",
    "./forms": "./src/components/forms.tsx",
    "./tree": "./src/components/tree.tsx",
    "./collections": "./src/components/collections.tsx",
    "./domain": "./src/components/domain.tsx"
  },
  "scripts": {
    "lint": "eslint --max-warnings 0 .",
    "typecheck": "tsc --project tsconfig.json",
    "test": "node --test scripts/tokens.check.js && vitest run --coverage",
    "gen": "node scripts/tokens.js",
    "tokens:check": "node scripts/tokens.js --check",
    "size": "node scripts/component-budgets.js",
    "build": "ladle build && node scripts/check-catalogue.js",
    "catalogue": "ladle serve",
    "catalogue:preview": "ladle preview",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "1.2.1",
    "@radix-ui/react-slot": "1.4.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "tailwind-merge": "3.7.0",
    "lucide-react": "1.61.0",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-context-menu": "2.4.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.14.22",
    "react-hook-form": "7.90.0",
    "zod": "4.6.7",
    "@hookform/resolvers": "6.0.0"
  },
  "peerDependencies": {
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "culori": "4.0.2",
    "vite": "8.3.3",
    "@ladle/react": "5.1.1",
    "@tailwindcss/vite": "4.3.3",
    "@playwright/test": "1.63.0",
    "@axe-core/playwright": "4.14.0"
  },
  "sideEffects": [
    "**/*.css"
  ]
}
