@startuml
!include <C4/C4_Container>
LAYOUT_TOP_DOWN()
title Open-Source PSIM Platform - containers
System_Ext(source, "External Equipment", "Manufacturer API")
System_Ext(keycloak, "Keycloak", "OIDC, PKCE, MFA")
Container(sdk, "Connector SDK", "C++23 / gRPC", "Disk log, acknowledgments, commands, snapshots")
System_Boundary(platform, "Open-Source PSIM Platform") {
 Container(web, "Web Application", "React / TypeScript", "Console, administration, auditing, and reports")
 Container(api, "API Gateway", "C++23 / Beast", "REST v1, realtime, JWT, ABAC, shared quotas")
 Container(gateway, "Connector Gateway", "C++23 / gRPC", "mTLS, registrations, lease, heartbeat, input and commands")
 Container(normalizer, "Normalizer", "C++23", "Event mapping, deduplication, and enrichment")
 Container(correlation, "Correlation Engine", "C++23 / RocksDB", "Rules, windows, signals, and changelog")
 Container(incident, "Incident Service", "C++23 / REST", "Grouping, Lifecycle, and Responsibilities")
 Container(response, "Response Engine", "C++23 / REST", "Scenarios, SLAs, timers, and escalation")
 Container(command, "Command Service", "C++23 / REST", "Acknowledgements, deadlines, and command results")
 Container(notification, "Notification Service", "C++23", "Notification queue, receipts, retries")
 Container(catalog, "Resource Catalog", "C++23 / REST", "Hierarchy, sources, floor plans and maintenance")
 Container(history, "Event History", "C++23 / REST", "Events, relationships, search, and maintaining history")
 Container(projection, "Projection Service", "C++23 / REST", "Console snapshots, freshness and reporting facts")
 Container(audit, "Audit Service", "C++23 / REST", "Hash chain and independent checkpoints")
 Container(cli, "psimctl", "C++23", "Copies, restoration, DLQ, replay, and diagnosis")
 ContainerQueue(kafka, "Kafka", "KRaft / Protobuf", "Versioned streams, transactions, and offsets")
 ContainerDb(pg, "PostgreSQL", "SQL / TLS", "Service schemas, inbox and outbox")
 ContainerDb(ch, "ClickHouse", "Native TLS / Keeper", "Event history and analytical facts")
 ContainerDb(cache, "Valkey", "RESP3 / Sentinel", "Sessions, Quotas, and Projection Caching")
 ContainerDb(files, "SeaweedFS", "S3 / HTTPS", "Private immutable floor plans")
 Container(registry, "Schema Registry", "Apicurio", "Compatibility with Protobuf schemas")
}
Rel(source, sdk, "Events and Results")
Rel(sdk, gateway, "Protocol v1", "gRPC mTLS")
Rel(web, api, "Snapshots and Deltas", "HTTPS / WSS")
Rel(web, keycloak, "Sign-in", "OIDC + PKCE")
Rel(api, projection, "Console and report reads", "HTTPS mTLS")
Rel(api, incident, "Operations with incidents", "HTTPS mTLS")
Rel(gateway, kafka, "raw / ingest.state / command results")
Rel(kafka, normalizer, "raw")
Rel(normalizer, kafka, "normalized / state / offsets")
Rel(kafka, correlation, "normalized / config")
Rel(correlation, kafka, "signals / changelog / offsets")
Rel(kafka, incident, "signals / response events")
Rel(incident, pg, "inbox + aggregate + outbox")
Rel(incident, kafka, "incident events")
Rel(kafka, response, "incident events")
Rel(response, kafka, "response events")
Rel(kafka, command, "command requests / results")
Rel(command, kafka, "commands")
Rel(kafka, notification, "notification intents")
Rel(kafka, history, "normalized / signal links")
Rel(history, ch, "History and Search")
Rel(kafka, projection, "Domain streams")
Rel(projection, cache, "Snapshot cache")
Rel(kafka, audit, "audit events")
Rel(catalog, files, "Floor Plans")
Rel(catalog, pg, "Metadata and outbox")
Rel(gateway, cache, "Session Registry")
Rel(api, cache, "Shared quotas")
Rel(cli, api, "Administrative Operations")
Rel(gateway, registry, "Schemas")
@enduml
