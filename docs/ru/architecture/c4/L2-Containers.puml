@startuml
!include <C4/C4_Container>
LAYOUT_TOP_DOWN()
title Open-Source PSIM Platform - контейнеры
System_Ext(source, "Внешнее оборудование", "API производителя")
System_Ext(keycloak, "Keycloak", "OIDC, PKCE, MFA")
Container(sdk, "Connector SDK", "C++23 / gRPC", "Дисковый журнал, подтверждения, команды, снимки")
System_Boundary(platform, "Open-Source PSIM Platform") {
 Container(web, "Web Application", "React / TypeScript", "Консоль, администрирование, аудит и отчёты")
 Container(api, "API Gateway", "C++23 / Beast", "REST v1, realtime, JWT, ABAC, общие квоты")
 Container(gateway, "Connector Gateway", "C++23 / gRPC", "mTLS, регистрации, lease, heartbeat, ввод и команды")
 Container(normalizer, "Normalizer", "C++23", "Отображение, дедупликация и обогащение")
 Container(correlation, "Correlation Engine", "C++23 / RocksDB", "Правила, окна, сигналы и changelog")
 Container(incident, "Incident Service", "C++23 / REST", "Группировка, жизненный цикл и ответственность")
 Container(response, "Response Engine", "C++23 / REST", "Сценарии, SLA, таймеры и эскалации")
 Container(command, "Command Service", "C++23 / REST", "Подтверждения, дедлайны и результаты команд")
 Container(notification, "Notification Service", "C++23", "Очередь уведомлений, квитанции, повторы")
 Container(catalog, "Resource Catalog", "C++23 / REST", "Иерархия, источники, планы и обслуживание")
 Container(history, "Event History", "C++23 / REST", "События, связи, поиск и удержание истории")
 Container(projection, "Projection Service", "C++23 / REST", "Снимки консоли, актуальность и отчётные факты")
 Container(audit, "Audit Service", "C++23 / REST", "Цепочка хэшей и независимые контрольные точки")
 Container(cli, "psimctl", "C++23", "Копии, восстановление, DLQ, replay и диагностика")
 ContainerQueue(kafka, "Kafka", "KRaft / Protobuf", "Версионированные потоки, транзакции и смещения")
 ContainerDb(pg, "PostgreSQL", "SQL / TLS", "Схема на сервис, inbox и outbox")
 ContainerDb(ch, "ClickHouse", "Native TLS / Keeper", "История событий и аналитические факты")
 ContainerDb(cache, "Valkey", "RESP3 / Sentinel", "Сессии, квоты и кэш проекций")
 ContainerDb(files, "SeaweedFS", "S3 / HTTPS", "Закрытые неизменяемые версии планов")
 Container(registry, "Schema Registry", "Apicurio", "Совместимость схем Protobuf")
}
Rel(source, sdk, "События и результаты")
Rel(sdk, gateway, "Протокол v1", "gRPC mTLS")
Rel(web, api, "Снимки и дельты", "HTTPS / WSS")
Rel(web, keycloak, "Вход", "OIDC + PKCE")
Rel(api, projection, "Чтение консоли и отчётов", "HTTPS mTLS")
Rel(api, incident, "Операции с инцидентами", "HTTPS mTLS")
Rel(gateway, kafka, "raw / ingest.state / command results")
Rel(kafka, normalizer, "raw")
Rel(normalizer, kafka, "normalized / state / offsets")
Rel(kafka, correlation, "normalized / config")
Rel(correlation, kafka, "signals / changelog / offsets")
Rel(kafka, incident, "signals / response events")
Rel(incident, pg, "inbox + aggregate + outbox")
Rel(incident, kafka, "incident events")
Rel(kafka, response, "incident events")
Rel(response, kafka, "response events")
Rel(kafka, command, "command requests / results")
Rel(command, kafka, "commands")
Rel(kafka, notification, "notification intents")
Rel(kafka, history, "normalized / signal links")
Rel(history, ch, "История и поиск")
Rel(kafka, projection, "Доменные потоки")
Rel(projection, cache, "Кэш снимков")
Rel(kafka, audit, "audit events")
Rel(catalog, files, "Версии планов")
Rel(catalog, pg, "Метаданные и outbox")
Rel(gateway, cache, "Реестр сессий")
Rel(api, cache, "Общие квоты")
Rel(cli, api, "Административные операции")
Rel(gateway, registry, "Схемы")
@enduml
