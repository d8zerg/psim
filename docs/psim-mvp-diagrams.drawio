ometry relative="1" as="geometry"/></mxCell><mxCell id="plan-34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="plan-29" target="plan-31"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="plan-35" value="M5" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1595" y="240" width="60" height="50" as="geometry"/></mxCell><mxCell id="plan-36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;dashed=1;" edge="1" parent="1" source="plan-31" target="plan-35"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="plan-37" value="Ф11 Приёмка&lt;br&gt;и выпуск&lt;br&gt;3,5 чн" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1760" y="120" width="140" height="90" as="geometry"/></mxCell><mxCell id="plan-38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="plan-31" target="plan-37"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="plan-39" value="M6&lt;br&gt;MVP" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1800" y="240" width="60" height="60" as="geometry"/></mxCell><mxCell id="plan-40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;dashed=1;" edge="1" parent="1" source="plan-37" target="plan-39"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="plan-41" value="M0 - архитектурная база; M1 - сквозной поток; M2 - ввод 50 000 событий/с; M3 - конвейер инцидентов; M4 - сквозной сценарий оператора; M5 - SLO подтверждены; M6 - MVP выпущен.&lt;br&gt;Итого ≈ 93 чн, с резервом 20% ≈ 112 чн. Команда 8-10 человек: 6-7 мес.; малая команда: 11-13 мес.; один инженер: 18-24 мес.&lt;br&gt;Синие блоки - критический путь; фиолетовые - параллельные потоки." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="560" width="1500" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
