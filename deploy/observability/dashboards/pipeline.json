{
  "uid": "psim-pipeline",
  "title": "Event Pipeline",
  "description": "Open-Source PSIM Platform. Event pipeline. Check data collection when data is missing.",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "15s",
      "30s",
      "1m",
      "5m"
    ],
    "time_options": [
      "15m",
      "1h",
      "6h",
      "24h",
      "7d"
    ]
  },
  "tags": [
    "psim",
    "operations"
  ],
  "graphTooltip": 1,
  "links": [
