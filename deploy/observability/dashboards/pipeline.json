  "annotations": {
    "list": [
      {
        "name": "Alerts",
        "enable": true,
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "expr": "ALERTS{deployment=~\"$deployment\",alertstate=\"firing\",severity=\"critical\"}",
        "step": "30s",
        "titleFormat": "{{alertname}}",
        "textFormat": "{{node}} {{service}}",
        "iconColor": "red"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "deployment",
        "label": "Deployment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(psim_monitoring_info, deployment)",
        "query": {
          "query": "label_values(psim_monitoring_info, deployment)",
          "refId": "deployment"
        },
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "node",
        "label": "Node",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(psim_monitoring_info{deployment=~\"$deployment\"}, node)",
        "query": {
          "query": "label_values(psim_monitoring_info{deployment=~\"$deployment\"}, node)",
          "refId": "node"
        },
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(up{job=\"psim-services\",deployment=~\"$deployment\"}, service)",
        "query": {
          "query": "label_values(up{job=\"psim-services\",deployment=~\"$deployment\"}, service)",
          "refId": "service"
        },
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "topic",
        "label": "Topic",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(psim_kafka_group_lag{deployment=~\"$deployment\",node=~\"$node\"}, topic)",
        "query": {
          "query": "label_values(psim_kafka_group_lag{deployment=~\"$deployment\",node=~\"$node\"}, topic)",
          "refId": "topic"
        },
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "group",
        "label": "Group",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(psim_kafka_group_lag{deployment=~\"$deployment\",node=~\"$node\",topic=~\"$topic\"}, group)",
        "query": {
          "query": "label_values(psim_kafka_group_lag{deployment=~\"$deployment\",node=~\"$node\",topic=~\"$topic\"}, group)",
          "refId": "group"
        },
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Throughput",
      "description": "Input, signals, and data recording. Different counters are not used to prove the absence of losses.",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "title": "Input from Kafka",
      "description": "Acknowledged Kafka publications.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service, topic) (rate(psim_kafka_produced_messages_total{deployment=~\"$deployment\",node=~\"$node\",service=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{service}} / {{topic}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "noValue": "No data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false,
            "showPoints": "never",
            "axisLabel": "",
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "No data",
                  "color": "gray"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto",
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
