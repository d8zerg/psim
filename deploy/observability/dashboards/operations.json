    {
      "id": 13,
      "type": "table",
      "title": "Active Alerts",
      "description": "Pending alerts await the configured duration. Firing alerts require investigation. Watchdog confirms the notification pipeline is running.",
      "gridPos": {
        "x": 0,
        "y": 59,
        "w": 24,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "label_join(ALERTS{deployment=~\"$deployment\",alertname!=\"PsimWatchdog\"}, \"context\", \" \", \"service\", \"owner\", \"component\", \"target\", \"backup\", \"certificate\", \"collector\", \"stage\", \"group\", \"topic\", \"partition\", \"volume\", \"tenant\", \"integration\", \"exporter\")",
          "instant": true,
          "format": "table",
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true,
            "minWidth": 100
          },
          "noValue": "-"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "alertname"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Remediation instructions",
                    "url": "../operations/runbooks/${__value.raw}",
                    "targetBlank": true
                  }
                ]
              },
              {
                "id": "displayName",
                "value": "Alert"
              },
              {
                "id": "custom.width",
                "value": 260
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "severity"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Severity"
              },
              {
                "id": "custom.width",
                "value": 100
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "alertstate"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "State"
              },
              {
                "id": "custom.width",
                "value": 100
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "node"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Node"
              },
              {
                "id": "custom.width",
                "value": 100
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "context"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Context"
              },
              {
                "id": "custom.width",
                "value": 380
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Severity",
            "desc": false
          }
        ]
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "severity",
                "alertstate",
                "alertname",
                "node",
                "context"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "deployment": true,
              "Value": true,
              "service": true,
              "component": true,
              "target": true,
              "backup": true,
              "certificate": true,
              "collector": true,
              "stage": true,
              "group": true,
              "topic": true,
              "partition": true,
              "volume": true,
              "tenant": true,
              "integration": true,
              "exporter": true
            },
            "indexByName": {
              "severity": 0,
              "alertstate": 1,
              "alertname": 2,
              "node": 3,
              "context": 4
            },
            "renameByName": {}
          }
        }
      ]
    }
