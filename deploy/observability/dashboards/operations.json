{
  "uid": "psim-operations",
  "title": "Operational checks",
  "description": "Open-Source PSIM Platform. Operational checks. Check data collection when data is missing.",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "15s",
      "30s",
      "1m",
      "5m"
    ],
    "time_options": [
      "15m",
      "1h",
      "6h",
      "24h",
      "7d"
    ]
  },
  "tags": [
    "psim",
    "operations"
  ],
  "graphTooltip": 1,
  "links": [
    {
      "title": "Platform overview",
      "url": "/monitoring/d/psim-overview",
      "type": "link",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "Event Pipeline",
      "url": "/monitoring/d/psim-pipeline",
      "type": "link",
      "keepTime": true,
