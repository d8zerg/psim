    {
      "id": 4,
      "title": "Срок сертификатов",
      "description": "Оставшееся время по каждому owner и certificate; предупреждение менее 30 суток.",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
