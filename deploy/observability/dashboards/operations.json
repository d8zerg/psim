  "annotations": {
    "list": [
      {
        "name": "Алерты",
        "enable": true,
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "expr": "ALERTS{deployment=~\"$deployment\",alertstate=\"firing\",severity=\"critical\"}",
        "step": "30s",
        "titleFormat": "{{alertname}}",
        "textFormat": "{{node}} {{service}}",
        "iconColor": "red"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "deployment",
        "label": "Поставка",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(psim_monitoring_info, deployment)",
        "query": {
          "query": "label_values(psim_monitoring_info, deployment)",
          "refId": "deployment"
        },
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "Все",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "node",
        "label": "Узел",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(psim_monitoring_info{deployment=~\"$deployment\"}, node)",
        "query": {
          "query": "label_values(psim_monitoring_info{deployment=~\"$deployment\"}, node)",
          "refId": "node"
        },
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "Все",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Резервные копии и доверие",
      "description": "Отсутствие задания копирования видно как 0 успешного timestamp и не считается успешным состоянием.",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "title": "Возраст успешной копии",
      "description": "Timestamp=0 означает, что подтверждённой копии нет. Порог по умолчанию 24 часа.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(time() - psim_backup_last_success_seconds{deployment=~\"$deployment\",node=~\"$node\"}) and (psim_backup_last_success_seconds{deployment=~\"$deployment\",node=~\"$node\"} > 0)",
          "legendFormat": "{{backup}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "noValue": "Нет подтверждённой копии",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 86400
              }
            ]
          },
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false,
            "showPoints": "never",
            "axisLabel": "",
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Нет данных",
                  "color": "gray"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto",
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
