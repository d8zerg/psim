    },
    {
      "title": "Infrastructure and Replication",
      "url": "/monitoring/d/psim-infrastructure",
      "type": "link",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "Storage and Capacity",
      "url": "/monitoring/d/psim-storage",
      "type": "link",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "Incidents and Connections",
      "url": "/monitoring/d/psim-business",
      "type": "link",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "Operational checks",
      "url": "/monitoring/d/psim-operations",
      "type": "link",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "RU",
      "url": "/monitoring/d/psim-operations-ru",
      "type": "link",
      "keepTime": true,
      "includeVars": true
