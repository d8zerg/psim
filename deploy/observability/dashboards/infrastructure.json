{
  "uid": "psim-infrastructure",
  "title": "Инфраструктура и репликация",
  "description": "Open-Source PSIM Platform. Инфраструктура и репликация. Пропуски данных требуют проверки сбора.",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "15s",
      "30s",
      "1m",
      "5m"
    ],
    "time_options": [
      "15m",
      "1h",
      "6h",
      "24h",
      "7d"
    ]
  },
  "tags": [
    "psim",
    "operations"
  ],
  "graphTooltip": 1,
  "links": [
    {
      "title": "Обзор платформы",
      "url": "/monitoring/d/psim-overview",
      "type": "link",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "Конвейер событий",
      "url": "/monitoring/d/psim-pipeline",
      "type": "link",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "Сервисы и API",
      "url": "/monitoring/d/psim-services",
      "type": "link",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "Инфраструктура и репликация",
      "url": "/monitoring/d/psim-infrastructure",
      "type": "link",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "Хранилища и ёмкость",
      "url": "/monitoring/d/psim-storage",
      "type": "link",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "Инциденты и подключения",
      "url": "/monitoring/d/psim-business",
      "type": "link",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "Эксплуатационные проверки",
      "url": "/monitoring/d/psim-operations",
      "type": "link",
      "keepTime": true,
      "includeVars": true
    }
  ],
  "annotations": {
    "list": [
      {
        "name": "Алерты",
        "enable": true,
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "expr": "ALERTS{deployment=~\"$deployment\",alertstate=\"firing\",severity=\"critical\"}",
        "step": "30s",
        "titleFormat": "{{alertname}}",
        "textFormat": "{{node}} {{service}}",
        "iconColor": "red"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "deployment",
        "label": "Поставка",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(psim_monitoring_info, deployment)",
        "query": {
          "query": "label_values(psim_monitoring_info, deployment)",
          "refId": "deployment"
        },
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "Все",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "node",
        "label": "Узел",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(psim_monitoring_info{deployment=~\"$deployment\"}, node)",
        "query": {
          "query": "label_values(psim_monitoring_info{deployment=~\"$deployment\"}, node)",
          "refId": "node"
        },
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "Все",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "component",
        "label": "Компонент",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(psim_probe_success{deployment=~\"$deployment\",node=~\"$node\"}, component)",
        "query": {
          "query": "label_values(psim_probe_success{deployment=~\"$deployment\",node=~\"$node\"}, component)",
          "refId": "component"
        },
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "Все",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Доступность и время ответа",
      "description": "Протокольные проверки выполняются на каждом узле, поэтому видны сетевые разделения приложений и инфраструктуры.",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "title": "Результат проверок",
      "description": "0 - отказ, 1 - успешная проверка; component и target определяют зависимость.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "psim_probe_success{deployment=~\"$deployment\",node=~\"$node\",component=~\"$component\"}",
          "legendFormat": "{{node}} / {{component}} / {{target}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bool",
          "min": 0,
          "noValue": "Нет данных",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false,
            "showPoints": "never",
            "axisLabel": "",
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
