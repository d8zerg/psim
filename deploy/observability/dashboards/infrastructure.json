          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(psim_probe_success{deployment=~\"$deployment\",node=~\"$node\"}, component)",
        "query": {
          "query": "label_values(psim_probe_success{deployment=~\"$deployment\",node=~\"$node\"}, component)",
          "refId": "component"
