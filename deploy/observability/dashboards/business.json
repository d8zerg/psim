{
  "uid": "psim-business",
  "title": "Incidents and Connections",
  "description": "Open-Source PSIM Platform. Incidents and connections. Check data collection when data is missing.",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "15s",
      "30s",
      "1m",
      "5m"
    ],
    "time_options": [
      "15m",
      "1h",
      "6h",
      "24h",
      "7d"
    ]
  },
  "tags": [
    "psim",
    "operations"
  ],
  "graphTooltip": 1,
  "links": [
    {
      "title": "Platform overview",
      "url": "/monitoring/d/psim-overview",
      "type": "link",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "Event Pipeline",
      "url": "/monitoring/d/psim-pipeline",
      "type": "link",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "Services and APIs",
      "url": "/monitoring/d/psim-services",
      "type": "link",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "Infrastructure and Replication",
      "url": "/monitoring/d/psim-infrastructure",
      "type": "link",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "Storage and Capacity",
      "url": "/monitoring/d/psim-storage",
      "type": "link",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "Incidents and Connections",
      "url": "/monitoring/d/psim-business",
      "type": "link",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "Operational checks",
      "url": "/monitoring/d/psim-operations",
      "type": "link",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "RU",
      "url": "/monitoring/d/psim-business-ru",
      "type": "link",
      "keepTime": true,
      "includeVars": true
    }
  ],
  "annotations": {
    "list": [
      {
        "name": "Alerts",
        "enable": true,
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "expr": "ALERTS{deployment=~\"$deployment\",alertstate=\"firing\",severity=\"critical\"}",
        "step": "30s",
        "titleFormat": "{{alertname}}",
        "textFormat": "{{node}} {{service}}",
        "iconColor": "red"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "deployment",
        "label": "Deployment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(psim_monitoring_info, deployment)",
        "query": {
          "query": "label_values(psim_monitoring_info, deployment)",
          "refId": "deployment"
        },
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "node",
        "label": "Node",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(psim_monitoring_info{deployment=~\"$deployment\"}, node)",
        "query": {
          "query": "label_values(psim_monitoring_info{deployment=~\"$deployment\"}, node)",
          "refId": "node"
        },
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(up{job=\"psim-services\",deployment=~\"$deployment\"}, service)",
        "query": {
          "query": "label_values(up{job=\"psim-services\",deployment=~\"$deployment\"}, service)",
          "refId": "service"
        },
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "tenant",
        "label": "Tenant",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values({__name__=~\"psim_incidents|psim_connectors_online|psim_sites_without_duty\",deployment=~\"$deployment\",node=~\"$node\"}, tenant)",
        "query": {
          "query": "label_values({__name__=~\"psim_incidents|psim_connectors_online|psim_sites_without_duty\",deployment=~\"$deployment\",node=~\"$node\"}, tenant)",
          "refId": "tenant"
        },
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
