      "targets": [
        {
          "refId": "A",
          "expr": "psim_incidents{deployment=~\"$deployment\",node=~\"$node\",tenant=~\"$tenant\"}",
          "legendFormat": "{{tenant}} / {{state}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "No data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
