      "url": "/monitoring/d/psim-infrastructure-ru",
      "type": "link",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "Хранилища и ёмкость",
      "url": "/monitoring/d/psim-storage-ru",
      "type": "link",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "Инциденты и подключения",
      "url": "/monitoring/d/psim-business-ru",
      "type": "link",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "Эксплуатационные проверки",
