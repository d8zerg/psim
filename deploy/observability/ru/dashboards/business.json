  "annotations": {
    "list": [
      {
        "name": "Алерты",
        "enable": true,
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "expr": "ALERTS{deployment=~\"$deployment\",alertstate=\"firing\",severity=\"critical\"}",
        "step": "30s",
        "titleFormat": "{{alertname}}",
        "textFormat": "{{node}} {{service}}",
        "iconColor": "red"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "deployment",
        "label": "Поставка",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(psim_monitoring_info, deployment)",
        "query": {
          "query": "label_values(psim_monitoring_info, deployment)",
          "refId": "deployment"
        },
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "Все",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "node",
        "label": "Узел",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(psim_monitoring_info{deployment=~\"$deployment\"}, node)",
        "query": {
          "query": "label_values(psim_monitoring_info{deployment=~\"$deployment\"}, node)",
          "refId": "node"
        },
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "Все",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "service",
        "label": "Сервис",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(up{job=\"psim-services\",deployment=~\"$deployment\"}, service)",
        "query": {
          "query": "label_values(up{job=\"psim-services\",deployment=~\"$deployment\"}, service)",
          "refId": "service"
        },
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "Все",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "tenant",
        "label": "Тенант",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values({__name__=~\"psim_incidents|psim_connectors_online|psim_sites_without_duty\",deployment=~\"$deployment\",node=~\"$node\"}, tenant)",
        "query": {
          "query": "label_values({__name__=~\"psim_incidents|psim_connectors_online|psim_sites_without_duty\",deployment=~\"$deployment\",node=~\"$node\"}, tenant)",
          "refId": "tenant"
        },
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "Все",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
