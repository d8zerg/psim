[Unit]
Description=Open-Source PSIM Platform encrypted backup
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/psim-platform/psimctl.json

[Service]
Type=oneshot
ExecStart=/usr/bin/psimctl --config /etc/psim-platform/psimctl.json backup create
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
TimeoutStartSec=6h
