# Host profile for the tsan preset (step 1.2, ADR-033): dependencies instrumented with ThreadSanitizer.
# The sanitizer flags take part in the package id, so instrumented binaries never mix with plain
# ones in the Conan cache. Build tools (protoc, grpc_cpp_plugin) use the plain profile:
#   conan install . -pr:h tools/conan/profiles/clang21-libcxx-tsan -pr:b tools/conan/profiles/clang21-libcxx
include(clang21-libcxx)

[conf]
tools.build:cflags=["-fsanitize=thread"]
tools.build:cxxflags=["-fsanitize=thread"]
tools.build:exelinkflags+=["-fsanitize=thread"]
tools.build:sharedlinkflags+=["-fsanitize=thread"]
tools.info.package_id:confs=["tools.build:cflags", "tools.build:cxxflags"]
# ThreadSanitizer does not intercept glibc C11 threads (thrd_create, mtx_*, cnd_*): their threads
# crash in the runtime and their locks are invisible to it. Renaming thrd_create fails librdkafka's
# C11 threads detection (try_compile), so it uses its own tinycthread over pthreads (ADR-041).
librdkafka/*:tools.build:cflags=["-fsanitize=thread", "-Dthrd_create=psim_tsan_no_c11_threads", "-DHAVE_ATOMICS_32_ATOMIC=1", "-DHAVE_ATOMICS_64_ATOMIC=1"]
