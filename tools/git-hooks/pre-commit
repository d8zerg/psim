#!/bin/sh
# PSIM pre-commit hook (step 1.2): fast checks of staged files. Installed by `task hooks:install`.
# The hook checks the working tree versions of staged files. The full gate is `task check`, which CI
# runs on every merge request (step 1.3), so `git commit --no-verify` does not bypass the standard.
set -eu
exec task hooks:pre-commit
