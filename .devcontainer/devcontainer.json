{
  "name": "psim-platform toolchain (Debian 13)",
  "build": {
    "dockerfile": "../tools/toolchain/Dockerfile",
    "options": ["--platform", "linux/amd64"],
    "args": {
      "BASE": "debian:trixie@sha256:913f6706df59a68922d1dd08f78c2476560a8d367897200a6005b00e5f67c2d5"
    }
  },
  "runArgs": ["--platform", "linux/amd64"],
  "workspaceMount": "source=${localWorkspaceFolder},target=/repo,type=bind",
  "workspaceFolder": "/repo",
  "remoteUser": "dev",
  "updateRemoteUserUID": true,
  "containerEnv": {
    "PSIM_PLATFORM": "debian13",
    "HOME": "/cache/home"
  },
  "mounts": [
    "source=${localWorkspaceFolder}/.cache/debian13/conan,target=/cache/conan,type=bind",
    "source=${localWorkspaceFolder}/.cache/debian13/ccache,target=/cache/ccache,type=bind",
    "source=${localWorkspaceFolder}/.cache/debian13/home,target=/cache/home,type=bind"
  ],
  "initializeCommand": "mkdir -p .cache/debian13/conan .cache/debian13/ccache .cache/debian13/home",
  "customizations": {
    "vscode": {
      "extensions": [
        "llvm-vs-code-extensions.vscode-clangd",
        "ms-vscode.cmake-tools",
        "bufbuild.vscode-buf",
        "task.vscode-task"
      ],
      "settings": {
        "cmake.useCMakePresets": "always",
        "cmake.configureOnOpen": false,
        "clangd.arguments": ["--compile-commands-dir=build/debian13/debug", "--header-insertion=never"]
      }
    }
  }
}
